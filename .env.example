# Server
L2O_HOST=0.0.0.0
L2O_PORT=8080
L2O_LOG_LEVEL=info
L2O_API_TOKEN=change-me

# Storage
L2O_VAULT_HOST_PATH=./vault
L2O_DATA_HOST_PATH=./data
L2O_TMP_HOST_PATH=./tmp
L2O_VAULT_PATH=/vault
L2O_OUTPUT_DIR=Clippings
L2O_ATTACHMENTS_DIR=Attachments
L2O_DATA_PATH=/app/data
L2O_TMP_PATH=/app/tmp
L2O_PLUGINS_PATH=/app/plugins

# Runtime defaults reserved for the clipping pipeline
L2O_TIMEZONE=Asia/Shanghai
L2O_LANGUAGE=zh-CN
L2O_WORKER_CONCURRENCY=1
L2O_PAGE_TIMEOUT_MS=30000
# Optional proxy used only by site plugins that explicitly request it
L2O_PROXY_SERVER=
L2O_IMAGE_TIMEOUT_MS=15000
L2O_MAX_IMAGES=100
L2O_MAX_IMAGE_BYTES=20971520
L2O_DUPLICATE_POLICY=skip
L2O_DEFAULT_CATEGORY=生活经验

# Optional AI enhancement (disabled by default)
L2O_AI_ENABLED=false
L2O_AI_PROVIDER=ollama
L2O_AI_BASE_URL=http://host.docker.internal:11434
L2O_AI_MODEL=qwen3:8b
L2O_AI_API_KEY=
L2O_AI_TIMEOUT_MS=60000
L2O_AI_MAX_CONTENT_CHARS=12000
